// SPDX-License-Identifier: GPL-2.0+ OR MIT
/*
 * MacBook Pro (16-inch, M5 Pro, 2026)
 *
 * target-type: J716s (Mac17,8)
 *
 * The M5 Pro is one T6050 die, die 0 (t6050-max.dtsi), as on the J716c. The
 * ADT lists all 18 CPUs in the order t6050-max.dtsi uses; the boot loader
 * removes any core it did not start. This file enables and configures what
 * has been brought up on this board; the SoC's other ports and buses stay
 * disabled until each is described for it.
 *
 * Copyright The Asahi Linux Contributors
 */

/dts-v1/;

#define T6050_J716S
#include <dt-bindings/leds/common.h>
#include "t6050-max.dtsi"

/ {
	compatible = "apple,j716s", "apple,t6050", "apple,arm-platform";
	model = "Apple MacBook Pro (16-inch, M5 Pro, 2026)";
	chassis-type = "laptop";

	aliases {
		serial0 = &dockchannel;
		/* The loader fills the N1's factory addresses through these */
		wifi0 = &n1_alpha;
		bluetooth0 = &n1_beta;
		/* The loader fills the keyboard layout from the ADT's keyboard node */
		keyboard = &keyboard;
		/* the boot loader reserves the SEP firmware and adds its manifests through this alias */
		sep = &sep;
		/* The loader finds the boot NOR's NVRAM partition through this alias */
		nvram = &nvram;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		framebuffer0: framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0 0 0 0>; /* To be filled by the loader */
			/* Format properties will be added by the loader */
			/* simpledrm reports an eDP connector for the built-in panel */
			apple,internal-panel;
			status = "disabled";
		};
	};

	/* Keyboard backlight: ADT pwm0/kbd-backlight, channel 0 at 25 kHz */
	led-controller {
		compatible = "pwm-leds";

		led-0 {
			pwms = <&fpwm0 0 40000>;
			label = "kbd_backlight";
			function = LED_FUNCTION_KBD_BACKLIGHT;
			color = <LED_COLOR_ID_WHITE>;
			max-brightness = <255>;
			default-state = "keep";
		};
	};
};

/* The keyboard backlight PWM (ADT pwm0) */
&fpwm0 {
	status = "okay";
};

/*
 * The SoC's inventory (t6050-peripherals.dtsi). Everything it declares is disabled; what
 * follows enables and completes what this board uses, so it comes after the inventory.
 */
#include "t6050-peripherals.dtsi"

/*
 * PCIe port 0: the N1 (Wi-Fi and Bluetooth). Port 1 is the SD reader, not yet
 * described. The registers, interrupt, DART streams and PERST# pin are the
 * J716c's: the J716s ADT has the same port. Port 0 and its DART stay disabled
 * until the boot loader enables them: once it trained the port, or with the
 * port down because the kernel can train it (port00 names the N1's power
 * line, the DART waits for its root complex). The kernel's train uses the
 * shared PHY (ADT reg[3]), its common block (reg[2] + 0x4000) and the windows
 * of the host tunable lists the boot loader copies from the ADT: axi2af
 * (reg[5]), pcieclkgen (reg[6]), phy-window (reg[2]) and phy-ip (reg[4]),
 * the same as the J714c's; the PHY and axi2af windows are cut to what their
 * lists reach.
 */
&pcie0 {
	reg = <0x1c 0xb0000000 0x0 0x10000000>,
	      <0x4 0x14000000 0x0 0x4000>,
	      <0x4 0x10028000 0x0 0x8000>,
	      <0x4 0x17010000 0x0 0x4000>,
	      <0x4 0x10024000 0x0 0x4000>,
	      <0x4 0x17020000 0x0 0x4000>,
	      <0x4 0x17004000 0x0 0x4000>,
	      <0x4 0x16000000 0x0 0x24000>,
	      <0x4 0x15044000 0x0 0x4000>,
	      <0x4 0x17000000 0x0 0x24000>,
	      <0x4 0x17800000 0x0 0x1b4000>;
	reg-names = "config", "rc", "port0", "phy0", "intr2axi0",
		    "phy-shared", "phy-common", "axi2af", "pcieclkgen",
		    "phy-window", "phy-ip";
	interrupts = <AIC_IRQ 0 1523 IRQ_TYPE_LEVEL_HIGH>;
	interrupt-names = "port0";

	/* The N1's three functions are on DART streams 1-3 */
	iommu-map = <0x100 &dart_apcie0 1 3>;
	bus-range = <0 4>;
	/*
	 * dart_apcie0 probes only once this host has the port up: fw_devlink
	 * must not make the host wait for it (strict mode enforces iommu-map)
	 */
	post-init-providers = <&dart_apcie0>;

	port00: pci@0,0 {
		device_type = "pci";
		reg = <0x0 0 0 0 0>;
		bus-range = <1 1>;
		/* The N1's power: ADT pci-bridge0 function-reset, gP13 */
		pwren-gpios = <&smc_gpio 0x13 GPIO_ACTIVE_HIGH>;
		/* PERST#: ADT pci-bridge0 function-perst, GPIO 80 */
		reset-gpios = <&pinctrl_ap 80 GPIO_ACTIVE_LOW>;
		apple,link-trained-by-bootloader;
		status = "disabled";

		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		interrupt-controller;
		#interrupt-cells = <1>;
		interrupt-map-mask = <0 0 0 7>;
		interrupt-map = <0 0 0 1 &port00 0 0 0 0>,
				<0 0 0 2 &port00 0 0 0 1>,
				<0 0 0 3 &port00 0 0 0 2>,
				<0 0 0 4 &port00 0 0 0 3>;

		/* platform ID (board 0x0c << 16) | chip 0x6050 */
		n1_control: control@0,0 {
			compatible = "pci106b,1900";
			reg = <0x10000 0x0 0x0 0x0 0x0>;
			firmware-name = "apple/centauri/j716s-ftab.bin";
			apple,centauri-platform-id = <0x000c6050>;
			apple,centauri-protocol = <27>;
		};

		n1_alpha: wifi@0,1 {
			compatible = "pci106b,1902";
			reg = <0x10100 0x0 0x0 0x0 0x0>;
			local-mac-address = [00 00 00 00 00 00];
		};

		n1_beta: bluetooth@0,2 {
			compatible = "pci106b,1903";
			reg = <0x10200 0x0 0x0 0x0 0x0>;
			local-bd-address = [00 00 00 00 00 00];
		};
	};
};

/* It answers only once port 0's root complex is up: pcie-apple then enables it */
&dart_apcie0 {
	apple,manual-availability;
};

/*
 * Nothing here drives the SMC pcIO outputs (apple,smc-pcio-gpio), and the AFE
 * reset above uses gp1c, so the node goes. This board's templates,
 * pKW8('pcIO', lo, hi) as (hi << 32) | lo, are the J716c's:
 *   0 dp2hdmi_pwr_en (0x0, 0x1a0000)
 *   1 hdmi_pwr_en    (0x800000, 0xf0000)
 *   2 afe-reset      (0x10000, 0x11c0000)
 */
/delete-node/ &smc_pcio;

/*
 * The SMC's first GPIO bank, the gP keys: the N1's power line is gP13.
 * gpio-macsmc drives it with the line's ADT template, pKW4("gP13",
 * 0x00800000): 0x00800000 | level, as m1n1 does.
 */
&smc {
	smc_gpio: gpio {
		compatible = "apple,smc-gpio";
		#gpio-cells = <2>;
		gpio-controller;
	};
};

/*
 * The power of the N1's port. iBoot leaves APCIE_SYS_GP, APCIE_PHY_SW and
 * APHY_GP_AUS5 in automatic power management with the block gated (boot
 * state 0x1000030f, 0x1400024f, 0x1000030f); the train needs them on and
 * staying on, as m1n1 raises them (target active, auto-PM off). Always on:
 * the port's link is kept through suspend-to-idle, and the host has no
 * power domain of its own. Parents as the ADT names them, the
 * register-less APCIE_SYS_GE left out. ADT pmgr devices APCIE_GP +0x118,
 * FAB6_SOC +0x138, APCIE_SYS_GP +0x148, APCIE_PHY_SW +0x1b0,
 * APHY_GP_AUS5_A +0x258, APHY_GP_AUS5 +0x280 (group 1).
 */
&pmgr1 {
	ps_apcie_gp: power-controller@118 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x118 4>;
		label = "apcie_gp";
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		status = "okay";
		apple,always-on;
	};

	ps_fab6_soc: power-controller@138 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x138 4>;
		label = "fab6_soc";
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		status = "okay";
		apple,always-on;
	};

	ps_apcie_sys_gp: power-controller@148 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x148 4>;
		label = "apcie_sys_gp";
		power-domains = <&ps_apcie_gp>, <&ps_fab6_soc>;
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		status = "okay";
		apple,always-on;
		apple,no-auto-pm;
	};

	ps_apcie_phy_sw: power-controller@1b0 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x1b0 4>;
		label = "apcie_phy_sw";
		power-domains = <&ps_apcie_sys_gp>;
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		status = "okay";
		apple,always-on;
		apple,no-auto-pm;
	};

	ps_aphy_gp_aus5_a: power-controller@258 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x258 4>;
		label = "aphy_gp_aus5_a";
		power-domains = <&ps_apcie_phy_sw>;
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		status = "okay";
		apple,always-on;
	};

	power-controller@280 {
		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
		reg = <0x280 4>;
		label = "aphy_gp_aus5";
		power-domains = <&ps_aphy_gp_aus5_a>;
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		status = "okay";
		apple,always-on;
		apple,no-auto-pm;
	};
};

/*
 * Type-C, from the ADT:
 *   ATC0 usb-drd0 left-back  hpm0 nub-spmi-a0 0x0c (the debug port, not described)
 *   ATC1 usb-drd1 left-front hpm1 nub-spmi-a0 0x0a
 *   ATC2 usb-drd2 right      hpm2 nub-spmi-a1 0x0c
 *   MagSafe                  hpm5 nub-spmi-a0 0x08 (not a USB-C connector)
 * There is no usb-drd3 and no nub-spmi-a2, so ATC3's USB chain and that bus
 * stay off.
 */
&atc3_phy_mbox {
	status = "disabled";
};

&atc3_phy {
	status = "disabled";
};

&usb_drd3 {
	status = "disabled";
};

&usb_drd3_dart_0 {
	status = "disabled";
};

&usb_drd3_dart_1 {
	status = "disabled";
};

&nub_spmi_a2 {
	status = "disabled";
};

/*
 * Left-front port (ATC1): the SN201202x hpm1, polled, and the connector
 * graph into usb_drd1 (USB2) and the combo PHY (SuperSpeed), in the shape of
 * t8142-j813-usb.dtsi. USB3 needs the PHY tunables the loader fills.
 */
&nub_spmi_a0 {
	hpm1: usb-pd@a {
		compatible = "apple,sn201202x";
		reg = <0xa SPMI_USID>;

		typec1: connector {
			compatible = "usb-c-connector";
			label = "USB-C Left-front";
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec1_hs: endpoint {
						remote-endpoint = <&usb_drd1_hs>;
					};
				};

				port@1 {
					reg = <1>;
					typec1_ss: endpoint {
						remote-endpoint = <&atc1_phy_typec>;
					};
				};
			};
		};
	};
};

&usb_drd1 {
	port {
		usb_drd1_hs: endpoint {
			remote-endpoint = <&typec1_hs>;
		};
	};
};

&atc1_phy {
	port {
		atc1_phy_typec: endpoint {
			remote-endpoint = <&typec1_ss>;
		};
	};
};

/*
 * Right port (ATC2): hpm2 on nub-spmi-a1, with USB and the USB4/Thunderbolt router, as on
 * the J714s. The inventory's nub-spmi-a1 has the generation 4 bus's three register windows
 * and IRQ (ADT nub-spmi-a1); the driver polls it and refuses an interrupt, so it takes the
 * first window only. The boot loader puts hpm2 in S0, parks the PIPE and fills the PHY's
 * tunables.
 */
&nub_spmi_a1 {
	reg = <0x2 0x8a1a8000 0x0 0x4000>;
	/delete-property/ interrupts;
	status = "okay";
};

#include "t6050-max-atc2.dtsi"

/* A host DROM (the J714s's, ADT /arm-io/acio2 thunderbolt-drom) until the boot loader replaces it */
&acio2_nhi {
	apple,thunderbolt-drom = [fd 02 00 00 00 00 00 00 00 90 19 c3 8c 00 5c 00
			00 00 00 00 00 00 08 81 82 02 82 00 00 00 08 82
			92 01 82 00 00 00 03 83 20 08 84 00 00 00 00 00
			00 08 85 00 00 00 00 00 00 05 86 09 01 00 08 87
			00 00 00 00 00 00 05 88 09 01 00 05 89 09 01 00
			05 8a 09 01 00 0e 01 41 70 70 6c 65 2c 20 49 6e
			63 2e 00 06 02 69 4f 53 00 00 00 00];
};

/*
 * Pin 112 takes an SError when read (as on the J716c), so only the pins a node
 * here names are exposed: 80 (PCIe port 0's PERST#), 106 and 107 (the speaker
 * amps' interrupt and shutdown line), 134 and 139 (the jack codec's interrupt
 * and reset).
 */
&pinctrl_ap {
	gpio-reserved-ranges = <0 80>, <81 25>, <108 26>, <135 4>, <140 81>;
};

/*
 * SMC sensors: the shared fan, power, voltage and current keys, plus every
 * readable float T* key through apple,discover-temperatures in
 * t6050-die0.dtsi, labelled with the key name. A key this SMC lacks only
 * drops its channel.
 *
 * Discovery refuses to run once any temperature channel exists, so the
 * shared temperature nodes go (their keys TH0x, TB0T, TCHP and TW0P are
 * discovered anyway), and so does apple,soc-die-keys, whose "SoC die TCMb"
 * channel would also count and fail the probe with -EINVAL. Only the
 * macsmc_soc_die thermal zone is lost; nothing here uses it. The
 * /delete-property/ can go with "hwmon: macsmc: Let discovered temperatures
 * join the SoC die zone".
 */
#include "hwmon-common.dtsi"
#include "hwmon-fan-dual.dtsi"
#include "hwmon-laptop.dtsi"

&smc_hwmon {
	/delete-property/ apple,soc-die-keys;
	/delete-node/ temperature-TH0x;
	/delete-node/ temperature-TB0T;
	/delete-node/ temperature-TCHP;
	/delete-node/ temperature-TW0P;

	/*
	 * The T6050 SMC spells the fan mode keys F0md/F1md, as on the J775D. No
	 * apple,fan-manual-control: the SMC drives the fans.
	 */
	fan-F0Ac {
		apple,fan-mode = "F0md";
	};

	fan-F1Ac {
		apple,fan-mode = "F1md";
	};
};

/*
 * The clusters' DVFS blocks have the T8112 layout (status at +0x50: current
 * p-state in bits 9:5, target in 4:0, read on this board), which
 * apple-soc-cpufreq drives through the T8112 compatible. A driver entry for
 * apple,t6050-cluster-cpufreq matches the first string and takes over.
 */
&cpufreq_mc0 {
	compatible = "apple,t6050-cluster-cpufreq", "apple,t8112-cluster-cpufreq";
};

&cpufreq_mc1 {
	compatible = "apple,t6050-cluster-cpufreq", "apple,t8112-cluster-cpufreq";
};

&cpufreq_pc {
	compatible = "apple,t6050-cluster-cpufreq", "apple,t8112-cluster-cpufreq";
};

/*
 * The console is on the USB debug link, which drains only while a host reads
 * it; the machine also boots with nothing attached there.
 */
&dockchannel {
	apple,tx-never-wait;
	status = "okay";
};

/* The keyboard and trackpad: the HID transport on the MTP's DockChannel FIFO */
&mtp_dockchannel {
	mtp_hid: input@8000 {
		compatible = "apple,dockchannel-hid";
		reg = <0x8000 0x1000>, <0xc000 0x1000>,
		      <0x0 0x1000>, <0x4000 0x1000>;
		reg-names = "config", "data", "rmt-config", "rmt-data";
		iommus = <&mtp_dart 0>;
		interrupt-parent = <&mtp_dockchannel>;
		interrupts = <2 IRQ_TYPE_LEVEL_HIGH>,
			     <3 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "tx", "rx";
		apple,fifo-size = <0x800>;
		apple,helper-cpu = <&mtp>;
		/*
		 * The AFE reset is the SMC pcIO output J716c uses (template 2 below).
		 * The same line is SMC GPIO gp1c, active low, which gpio-macsmc drives.
		 */
		apple,afe-reset-gpios = <&smc_gpio_low 28 GPIO_ACTIVE_LOW>;

		multi-touch {
			apple,power-method = <2>;
			firmware-name = "apple/tpmtfw-j716s.bin";
		};

		keyboard: keyboard {
			hid-country-code = <0>;
			apple,keyboard-layout-id = <0>;
		};

		stm {
		};

		actuator {
		};

		tp-accel {
		};
	};
};

/*
 * The SEP (ADT sep, dart-sep): its mailbox, and its power domain with the two
 * fabric parents left to the firmware, which genpd votes on and never turns off.
 * The boot loader enables the SEP itself through its alias.
 */
&sep_mbox {
	status = "okay";
};

&ps_sep {
	status = "okay";
};

&ps_fab8_soc {
	apple,firmware-owned;
	status = "okay";
};

&ps_fab0_piogw {
	apple,firmware-owned;
	status = "okay";
};

/*
 * The ProRes engine (apr0) and its DART, in the SCODEC power state. Its
 * parent fab7-soc also feeds the display pipeline, so it is left to the
 * firmware, as fab0-piogw is.
 */
&ps_fab7_soc {
	apple,firmware-owned;
	status = "okay";
};

&ps_scodec {
	status = "okay";
};

&apr0_dart {
	status = "okay";
};

&apr0 {
	status = "okay";
};

/*
 * Both JPEG engines and their shared DART, under the media fabric that the
 * video encoder above already enables.
 */
&ps_jpg {
	status = "okay";
};

&jpeg0_dart {
	status = "okay";
};

&jpeg0 {
	status = "okay";
};

&jpeg1 {
	status = "okay";
};

/* The same T6050 camera as J716c; the loader sets the sensor type. */
#include "t6050-j716c-isp.dtsi"

/* The GPU and the internal panel, for the boot loader's handoff */
#include "t6050-j714s-gpu-panel.dtsi"

/* External displays, on the left-front and right ports */
#include "t6050-j714s-display.dtsi"

/* The Neural Engine, started only after the boot loader's preload hand-off */
#include "t6050-j714s-ane.dtsi"

/*
 * Sound through the AOP, as on J813 and the J714s: its audio service runs the serializers, the
 * CS42L84 headphone jack on admac-base-ns TX2/RX2 and the six SN012776 speaker amps
 * on TX0, their voltage and current sense on RX0 (ADT iop-audio-controller).
 *
 * The amps (ADT /arm-io/i2c1/audio-speaker* and /arm-io/i2c3/audio-speaker*) share
 * one shutdown line, AP pin 107 (function-reset of the first), and one fault
 * interrupt, pin 106. The ADT's speaker-config gives amp N playback slot N, its
 * voltage sense in slot 4N and current sense in 4N+2, in the order of the first
 * amp's speakerN: left woofer 1, right woofer 1, left woofer 2, right woofer 2,
 * left tweeter, right tweeter. The firmware's speaker frame is 250 BCLKs of 12 MHz
 * (ADT audio-speaker stream), which the amps' ratio detection rejects.
 */
/ {
	speaker_sdz: regulator-sn012776-sdz {
		compatible = "regulator-fixed";
		regulator-name = "sn012776-sdz";
		gpios = <&pinctrl_ap 107 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};
};

&i2c1 {
	status = "okay";

	speaker_left_woof1: codec@38 {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x38>;
		SDZ-supply = <&speaker_sdz>;
		apple,sdz-group-fail-closed;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Left Woofer 1";
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <2>;
		ti,vmon-slot-no = <0>;
		ti,bclk-ratio = <250>;
	};

	speaker_left_woof2: codec@39 {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x39>;
		SDZ-supply = <&speaker_sdz>;
		apple,sdz-group-fail-closed;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Left Woofer 2";
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <10>;
		ti,vmon-slot-no = <8>;
		ti,bclk-ratio = <250>;
	};

	speaker_left_tweet: codec@3a {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3a>;
		SDZ-supply = <&speaker_sdz>;
		apple,sdz-group-fail-closed;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Left Tweeter";
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <18>;
		ti,vmon-slot-no = <16>;
		ti,bclk-ratio = <250>;
	};
};

/* The I2C power states have no described parent (SIO), as for i2c1 and i2c2 */
&ps_i2c3 {
	/delete-property/ power-domains;
	status = "okay";
};

&i2c3 {
	/* The ADT gives i2c1, i2c2 and i2c3 the same clock-ids (4) */
	clocks = <&clkref>;
	status = "okay";

	speaker_right_woof1: codec@3b {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3b>;
		SDZ-supply = <&speaker_sdz>;
		apple,sdz-group-fail-closed;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Right Woofer 1";
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <6>;
		ti,vmon-slot-no = <4>;
		ti,bclk-ratio = <250>;
	};

	speaker_right_woof2: codec@3c {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3c>;
		SDZ-supply = <&speaker_sdz>;
		apple,sdz-group-fail-closed;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Right Woofer 2";
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <14>;
		ti,vmon-slot-no = <12>;
		ti,bclk-ratio = <250>;
	};

	speaker_right_tweet: codec@3d {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3d>;
		SDZ-supply = <&speaker_sdz>;
		apple,sdz-group-fail-closed;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Right Tweeter";
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <22>;
		ti,vmon-slot-no = <20>;
		ti,bclk-ratio = <250>;
	};
};

/*
 * The CS42L84 headphone codec (ADT /arm-io/i2c2/audio-codec-output): its reset line
 * is AP pin 139, driven high to run the codec, and its interrupt AP pin 134, level
 * low.
 */
&i2c2 {
	status = "okay";

	jack_codec: codec@4b {
		compatible = "cirrus,cs42l84";
		reg = <0x4b>;
		reset-gpios = <&pinctrl_ap 139 GPIO_ACTIVE_HIGH>;
		interrupts-extended = <&pinctrl_ap 134 IRQ_TYPE_LEVEL_LOW>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Jack";
	};
};

/ {
	sound {
		compatible = "apple,j716-macaudio", "apple,macaudio";
		model = "MacBook Pro J716";
		#address-cells = <1>;
		#size-cells = <0>;

		dai-link@0 {
			reg = <0>;
			link-name = "Headphone Jack";

			cpu {
				sound-dai = <&aop_audio 0>;
			};

			codec {
				sound-dai = <&jack_codec>;
			};
		};

		dai-link@1 {
			reg = <1>;
			link-name = "Speaker";
			/*
			 * Codecs in ADT speaker-config order, so that macaudio gives them
			 * playback slots 0-5 as macOS does (left channels in slots 0, 2
			 * and 4, right in 1, 3 and 5). The idle masks are the ADT
			 * amp-tx-zd-config rows 0 and 1: left woofer 1 drives zeros in the
			 * right amps' sense slots, right woofer 1 in the left amps'.
			 */
			dai-tdm-idle-mode-0 = "zero";
			dai-tdm-slot-tx-idle-mask-0 = <0xfff0f0f0>;
			dai-tdm-idle-mode-1 = "zero";
			dai-tdm-slot-tx-idle-mask-1 = <0xff0f0f0f>;

			cpu {
				sound-dai = <&aop_audio 3>;
			};

			codec {
				sound-dai = <&speaker_left_woof1>, <&speaker_right_woof1>,
					    <&speaker_left_woof2>, <&speaker_right_woof2>,
					    <&speaker_left_tweet>, <&speaker_right_tweet>;
			};
		};
	};
};

/* The AOP, booted through its setup port, with its sensor and audio services. */
&aop_mbox {
	status = "okay";
};

&aop_setup_mbox {
	status = "okay";
};

&aop_dart {
	status = "okay";
};

&aop {
	status = "okay";
};

/*
 * The microphone array: ADT audio-hp-mic, three microphones on leap-s RX0 through the
 * proxy ADMAC (Linux channel 1, as on J813), captured by the AOP audio service's own card.
 */
&admac_base_ns {
	status = "okay";
};

&admac_ec_proxy {
	status = "okay";
};

&aop_audio {
	apple,chassis-name = "J716";
	apple,machine-kind = "MacBook Pro";
	dmas = <&admac_base_ns 4>, <&admac_base_ns 5>,
	       <&admac_base_ns 0>, <&admac_base_ns 1>,
	       <&admac_ec_proxy 1>;
	dma-names = "cout", "cin", "spkr", "sense", "hpai";
};

/* The video decoder (ADT avd0, as on the J714c), its DART and power states. */
&pmgr4 {
	status = "okay";
};

/* macOS turns FAB1_SOC on once at boot and never gates it. */
&ps_fab1_soc {
	apple,always-on;
	status = "okay";
};

&ps_avd_sys {
	status = "okay";
};

&avd_dart {
	status = "okay";
};

&avd {
	status = "okay";
};

/*
 * The video encoder (ADT ave0), its DARTs and the VENC0 power states. Like
 * FAB1_SOC, macOS sets FAB0_SOC active once at boot and never gates it; the PIO
 * gateway above it is left to the firmware.
 */
&ps_fab1_piogw {
	apple,firmware-owned;
	status = "okay";
};

&ps_fab0_soc {
	apple,always-on;
	status = "okay";
};

&ps_venc0_sys {
	status = "okay";
};

&ps_venc0_dma {
	status = "okay";
};

&ps_venc0_pipe4 {
	status = "okay";
};

&ps_venc0_pipe5 {
	status = "okay";
};

&ps_venc0_me0 {
	status = "okay";
};

&ps_venc0_me1 {
	status = "okay";
};

&ave0_dart {
	status = "okay";
};

&ave0_dart1 {
	status = "okay";
};

&ave0 {
	status = "okay";
};

/*
 * The internal 16.2-inch mini-LED panel on the die's display engine (dcp), the
 * boot loader's hand-off target. The dimensions and the 600 nit maximum
 * brightness are the panel's; the 14-inch panel of t6050-j714s-gpu-panel.dtsi is
 * replaced. The display driver does not probe without the bandwidth scratch: the
 * PMC metadata's register block (dispext0 reg[4]), word 5 at +0x20000. The
 * firmware asks for its clocks by index into apple,clock-ids (ADT disp0
 * clock-ids 361 and 458, as on the J716c); the loader verifies the identifiers
 * and fills the rates.
 */
/ {
	dcp_fw_clk361: clock-dcp-firmware-361 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <810000000>;
		clock-output-names = "dcp_firmware_361";
	};

	dcp_fw_clk458: clock-dcp-firmware-458 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <521064992>;
		clock-output-names = "dcp_firmware_458";
	};
};

&dcp {
	apple,dcp-index = <0>;
	apple,bw-scratch = <&dcpext0_pmc 0 5 0x20000>;
	apple,clock-ids = <361 458>;
	clocks = <&dcp_fw_clk361>, <&dcp_fw_clk458>;
	clock-names = "firmware-0", "firmware-1";

	panel {
		compatible = "apple,panel-j716", "apple,panel-mini-led", "apple,panel";
		width-mm = <345>;
		height-mm = <223>;
		/delete-property/ adj-height-mm;
		apple,max-brightness = <600>;
	};
};

/*
 * The boot NOR and its NVRAM partition, for asahi-nvram and asahi-bless. ADT
 * /arm-io/qspi has one child, spinor (chip select 0), with the children
 * firmware, anvram and syscfg; anvram is 0x700000, 0xc0000 (12 banks of 64 KiB,
 * /chosen nvram-bank-count 12, nvram-bank-size 0x10000). Only the partition is
 * described, single-wire as on the J775D, so spi-nor sends no quad-enable write
 * at probe. spi-apple-qspi refuses programs and erases until its board row
 * qualifies the part.
 */
&qspi {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;
		spi-rx-bus-width = <1>;
		spi-tx-bus-width = <1>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			nvram: partition@700000 {
				label = "nvram";
				reg = <0x700000 0xc0000>;
			};
		};
	};
};

/*
 * The GPU's power states. The group's PMGR (pmgr_gpx) stays disabled and the boot loader
 * enables it with the GPU hand-off, as for the GPU and its mailboxes; the states under it
 * are enabled here so that enabling the group is enough.
 */
&ps_gpx {
	status = "okay";
};

&ps_afr {
	status = "okay";
};

&ps_gfx {
	status = "okay";
};
