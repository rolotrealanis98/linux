# J716s GPU bring-up: on top of `make defconfig asahi.config j716s.config`.
# Rust and Aurora's GPU driver built in (the root file system carries no modules); the PMP
# driver stays off, nothing in the G17 M5 path needs it. Only the T6050 G17 backend: the
# optional M4/M5 (T8142)/M6/M3 backends stay off.
CONFIG_RUST=y
CONFIG_DRM_ASAHI=y
# CONFIG_DRM_ASAHI_G15 is not set
# CONFIG_DRM_ASAHI_G16 is not set
# CONFIG_DRM_ASAHI_G18 is not set
# CONFIG_DRM_ASAHI_M5 is not set
# CONFIG_DRM_ASAHI_DEBUG_ALLOCATOR is not set
# CONFIG_APPLE_PMP is not set
# m1n1's stage-2 log (reserved-memory "phram" node, label m1n1_stage2.log) readable as /dev/mtdN without
# modules: the E1 checks read m1n1's GPU hand-off lines from it.
CONFIG_MTD_PHRAM=y
